{
  "manifest_version": 3,
  "name": "Suno Watcher Beta",
  "short_name": "Suno Watcher",
  "description": "Beta watcher for selected Suno tracks; opens a popup download flow for WAV files with lyrics and covers.",
  "version": "0.4.0",
  "version_name": "0.4.0 beta",
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png",
    "default_title": "Suno Watcher Beta"
  },
  "icons": { "128": "icon128.png" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["*://*.suno.com/*"], "js": ["watcher.js"], "run_at": "document_idle" }
  ],
  "host_permissions": [
    "*://*.suno.com/*",
    "https://studio-api.prod.suno.com/*",
    "https://cdn1.suno.ai/*",
    "https://cdn2.suno.ai/*"
  ],
  "permissions": ["downloads", "scripting", "activeTab", "storage", "notifications", "contextMenus", "tabs"]
}
