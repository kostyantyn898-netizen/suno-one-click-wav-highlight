{
  "manifest_version": 3,
  "name": "Suno WAV Auto Marker",
  "short_name": "Suno Marker",
  "description": "Choose 1-10 Suno tracks for manual WAV download or AUTO batch size. Saves WAV, lyrics, and covers, then highlights/selects tracks for manual cleanup.",
  "version": "1.5.5",
  "action": {
    "default_icon": "SunoDownloader.png",
    "default_popup": "popup.html",
    "default_title": "Suno WAV Auto Marker"
  },
  "icons": {
    "128": "SunoDownloader_128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "*://*.suno.com/*",
    "https://studio-api.prod.suno.com/*",
    "https://studio-api-prod.suno.com/*",
    "https://cdn1.suno.ai/*",
    "https://cdn2.suno.ai/*"
  ],
  "permissions": [
    "downloads",
    "scripting",
    "activeTab",
    "storage"
  ]
}




